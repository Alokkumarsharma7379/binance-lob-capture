if(NOT DEFINED APP OR NOT DEFINED FIXTURES OR NOT DEFINED WORK)
    message(FATAL_ERROR "APP, FIXTURES and WORK are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(run_root "${WORK}/replay-cli-${run_id}")
foreach(run IN ITEMS first second)
    execute_process(COMMAND "${APP}" --replay "${FIXTURES}/stage4e_market.csv"
        --output-dir "${run_root}/${run}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Replay ${run}: exit=${result}\n${stdout}\n${stderr}")
    endif()
    message(STATUS "Replay ${run}: exit=${result}\n${stderr}")
    set(actual "${run_root}/${run}/stage4e_market_orderbook.csv")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${actual}"
        "${FIXTURES}/stage4e_expected_orderbook.csv" RESULT_VARIABLE comparison)
    if(NOT comparison EQUAL 0)
        message(FATAL_ERROR "CLI output differs from hand-calculated expected bytes")
    endif()
endforeach()
file(SHA256 "${run_root}/first/stage4e_market_orderbook.csv" original_hash)
execute_process(COMMAND "${APP}" --replay "${FIXTURES}/stage4e_market.csv"
    --output-dir "${run_root}/first" RESULT_VARIABLE duplicate ERROR_VARIABLE duplicate_error)
file(SHA256 "${run_root}/first/stage4e_market_orderbook.csv" after_hash)
if(NOT duplicate EQUAL 1 OR NOT original_hash STREQUAL after_hash)
    message(FATAL_ERROR "Existing output was not preserved")
endif()
execute_process(COMMAND "${APP}" --replay "${run_root}/missing.csv"
    --output-dir "${run_root}/missing-output" RESULT_VARIABLE missing ERROR_VARIABLE missing_error)
if(NOT missing EQUAL 1)
    message(FATAL_ERROR "Missing replay input: expected exit 1, got ${missing}")
endif()
execute_process(COMMAND "${APP}" --replay "${FIXTURES}/stage4e_market.csv" --duration 1
    RESULT_VARIABLE incompatible ERROR_VARIABLE incompatible_error)
if(NOT incompatible EQUAL 2)
    message(FATAL_ERROR "Incompatible options: expected exit 2, got ${incompatible}")
endif()
file(WRITE "${run_root}/malformed.csv" "wrong,header\n")
execute_process(COMMAND "${APP}" --replay "${run_root}/malformed.csv"
    --output-dir "${run_root}/bad-output" RESULT_VARIABLE malformed ERROR_VARIABLE malformed_error)
if(NOT malformed EQUAL 1 OR NOT malformed_error MATCHES "replay record 1")
    message(FATAL_ERROR "Malformed CSV: expected exit 1 with record context, got ${malformed}")
endif()
message(STATUS "Existing-output exit=${duplicate}; missing-input exit=${missing}; incompatible-options exit=${incompatible}; malformed-input exit=${malformed}")
message(STATUS "Both CLI replays match expected SHA-256 ${original_hash}")
